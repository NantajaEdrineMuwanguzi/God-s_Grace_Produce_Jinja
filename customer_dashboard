<?php
session_start();
include 'config/db.php';

/*
====================================
CHECK LOGIN
====================================
*/

if(!isset($_SESSION['user_id'])){

    header("Location: login.php");
    exit();
}

/*
====================================
ONLY CUSTOMERS
====================================
*/

if($_SESSION['role'] != "customer"){

    header("Location: login.php");
    exit();
}

/*
====================================
USER DATA
====================================
*/

$fullname = $_SESSION['fullname'];

$success = "";
$error = "";

/*
====================================
SUBMIT REVIEW / TESTIMONIAL
====================================
*/

if(isset($_POST['submit_review'])){

    $rating = $_POST['rating'];
    $review = mysqli_real_escape_string(
        $conn,
        $_POST['review']
    );

    /*
    ====================================
    GET SELLER NAME
    FROM PRODUCTS TABLE
    ====================================
    */

    $seller_query = mysqli_query($conn,

    "SELECT seller_name
    FROM products
    LIMIT 1");

    $seller_data =
    mysqli_fetch_assoc($seller_query);

    $seller_name =
    $seller_data['seller_name'];

    /*
    ====================================
    INSERT REVIEW
    ====================================
    */

    $insert = mysqli_query($conn,

    "INSERT INTO reviews(

    customer_name,
    seller_name,
    rating,
    review

    ) VALUES(

    '$fullname',
    '$seller_name',
    '$rating',
    '$review'

    )");

    if($insert){

        $success =
        "Thank you! Your testimonial has been submitted successfully.";

    }else{

        $error =
        "Failed to submit review.";
    }
}
?>

